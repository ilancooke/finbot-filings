DOWNLOAD_FOLDER=/absolute/path/to/finbot/data/raw/filings/
SECTION_FOLDER=/absolute/path/to/finbot/data/filings/sections/
XBRL_FOLDER=/absolute/path/to/finbot/data/filings/xbrl/
SEC_USER_AGENT=Finbot your-email@example.com
SEC_CIK_OVERRIDES=EXAMPLE:123456

# finbot_ingestion configuration (export into the process environment).
# SEC_USER_AGENT above is shared; legacy CLI throttling is unchanged.
SEC_MAX_REQUESTS_PER_SECOND=5
SEC_CONNECT_TIMEOUT_SECONDS=10
SEC_READ_TIMEOUT_SECONDS=30
SEC_MAX_ATTEMPTS=3
SEC_BACKOFF_BASE_SECONDS=1
SEC_BACKOFF_CAP_SECONDS=30
SEC_MAX_REDIRECTS=5

# Phase 3 persistence adapters only; these do not provision AWS resources.
# SEC and legacy workflows do not require these settings.
AWS_REGION=us-east-1
COMPANIES_TABLE=finbot-ingestion-companies
CALENDAR_TABLE=finbot-ingestion-calendar
FILINGS_TABLE=finbot-ingestion-filings
ARTIFACTS_TABLE=finbot-ingestion-artifacts
DYNAMODB_CONNECT_TIMEOUT_SECONDS=5
DYNAMODB_READ_TIMEOUT_SECONDS=10
DYNAMODB_MAX_ATTEMPTS=3
DYNAMODB_PAGE_SIZE=100
DYNAMODB_MAX_WORKERS=4
DYNAMODB_CAS_ATTEMPTS=4
DYNAMODB_MAX_CALENDAR_RANGE_DAYS=366

# Phase 4 adapters/services only. All resources must already exist.
ARTIFACT_BUCKET=finbot-ingestion-artifacts
MAX_ARTIFACT_BYTES=67108864
ARTIFACT_READY_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:finbot-artifact-ready
INGESTION_DEAD_LETTER_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/finbot-ingestion-failed
INGESTION_AWS_CONNECT_TIMEOUT_SECONDS=5
INGESTION_AWS_READ_TIMEOUT_SECONDS=30
INGESTION_AWS_MAX_ATTEMPTS=3
INGESTION_AWS_MAX_WORKERS=2
INGESTION_MAX_STAGE_FAILURES=3
INGESTION_CHECKPOINT_ATTEMPTS=3
INGESTION_DEAD_LETTER_ATTEMPTS=3
INGESTION_MAX_INFLIGHT_ARTIFACTS=2
INGESTION_RECOVERY_PAGE_SIZE=100
INGESTION_BACKOFF_BASE_SECONDS=1
INGESTION_BACKOFF_CAP_SECONDS=30

# Phase 5 explicit calendar sync. Placeholder raises; it never invents empty data.
# Cadence settings are consumed by a future Phase 6 runtime, not background tasks here.
CALENDAR_PROVIDER=placeholder
CALENDAR_LOOKAHEAD_DAYS=90
CALENDAR_NEAR_TERM_DAYS=3
CALENDAR_FULL_REFRESH_SECONDS=86400
CALENDAR_NEAR_TERM_REFRESH_SECONDS=0
CALENDAR_STALE_AFTER_SECONDS=172800
CALENDAR_MAX_COMPANIES=1000
CALENDAR_MAX_SNAPSHOT_EVENTS=5000
CALENDAR_COMPANY_PAGE_SIZE=100
CALENDAR_PROVIDER_ATTEMPTS=3
CALENDAR_CHECKPOINT_ATTEMPTS=3
CALENDAR_BACKOFF_BASE_SECONDS=1
CALENDAR_BACKOFF_CAP_SECONDS=30
